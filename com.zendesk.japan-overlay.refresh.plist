<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.zendesk.japan-overlay.refresh</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/justine.mendez/Desktop/anything2026/japan-overlay-dashboard/auto_refresh.sh</string>
  </array>

  <!-- Run daily at 6:00 AM Manila time (the Mac is on Asia/Manila; the "PST"
       label on this machine is a misnomer — its +0800 offset IS Manila). -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>6</integer>
    <key>Minute</key><integer>0</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/justine.mendez/Desktop/anything2026/japan-overlay-dashboard/logs/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/justine.mendez/Desktop/anything2026/japan-overlay-dashboard/logs/launchd.err.log</string>
</dict>
</plist>
